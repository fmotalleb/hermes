APP_NAME=hermes

HTTP_PORT=8000
METRICS_PORT=0

ADMIN_NO_AUTH=1
ADMIN_USER=admin
ADMIN_PASS=admin

DATABASE_URL=postgres://hermes:hermes@127.0.0.1:5432/hermes?sslmode=disable

DB_MAX_IDLE_CONNECTION=5
DB_MAX_OPEN_CONNECTION=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

PUBSUB_BACKEND=rabbitmq
PUBSUB_CONSUMER_GROUP=hermes-admin

PUBSUB_BROKERS=
PUBSUB_RABBITMQ_URI=amqp://hermes:hermes@127.0.0.1:5672/

TRACE_EXPORTER=jaeger
TRACER_URL=localhost:4317
TRACER_RATIO=1

DNS_LISTEN_ADDR=:8053
DNS_PROTOCOL=udp


DNS_CACHE_BACKEND=memory
