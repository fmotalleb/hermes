package templates

import (
	"fmt"
	"strings"
)

templ ZoneCreate(options []ForwardZoneOption, fallbackForwardZoneID string) {
	<section class="panel">
		<h2>Create Zone</h2>
		<form method="post" action="/admin/zones">
			<div class="grid">
				<input type="text" name="name" placeholder="example.com" required/>
				<select name="forward_selection">
					<option value="default">Default Fallback (not set per-zone)</option>
					<option value="none">None (disable forwarding)</option>
					for _, opt := range options {
						<option value={ "id:" + opt.ID }>{ opt.Name + " (" + strings.Join(opt.Addresses, ", ") + ")" }</option>
					}
				</select>
				<input type="number" name="cache_ttl" min="0" value="300"/>
				<button type="submit">Create</button>
			</div>
		</form>
	</section>
}

templ ZoneRow(zone ZoneData) {
	<section class="panel zone-compact">
		<div class="zone-row">
			<div>
				<div class="zone-title">{ zone.Name }</div>
				<div class="subtle">Forward: { zone.ForwardLabel } | Cache TTL: { fmt.Sprintf("%d", zone.CacheTTL) }s | Records: { fmt.Sprintf("%d", len(zone.Records)) }</div>
			</div>
			<div class="zone-actions">
				<button type="button" data-open-modal={ fmt.Sprintf("zone-records-%s", zoneDOMID(zone.Name)) }>Records</button>
				<button type="button" data-open-modal={ fmt.Sprintf("zone-config-%s", zoneDOMID(zone.Name)) }>Config</button>
				<form method="post" action={ fmt.Sprintf("/admin/zones/%s/delete", zonePathSegment(zone.Name)) }>
					<button class="btn-delete" type="submit">Delete</button>
				</form>
			</div>
		</div>
	</section>
}

templ ZoneConfigModal(zone ZoneData, options []ForwardZoneOption, fallbackForwardZoneID string) {
	<dialog id={ fmt.Sprintf("zone-config-%s", zoneDOMID(zone.Name)) } class="modal">
		<div class="modal-head">
			<h3>Zone Config - { zone.Name }</h3>
			<button type="button" data-close-modal={ fmt.Sprintf("zone-config-%s", zoneDOMID(zone.Name)) }>Close</button>
		</div>
		<form method="post" action={ fmt.Sprintf("/admin/zones/%s/config", zonePathSegment(zone.Name)) }>
			<div class="grid">
				<select name="forward_selection">
					<option value="default" selected?={ zone.ForwardMode == "default" }>Default Fallback (not set per-zone)</option>
					<option value="none" selected?={ zone.ForwardMode == "none" }>None (disable forwarding)</option>
					for _, opt := range options {
						<option value={ "id:" + opt.ID } selected?={ zone.ForwardMode == "custom" && zone.ForwardZoneID == opt.ID }>{ opt.Name + " (" + strings.Join(opt.Addresses, ", ") + ")" }</option>
					}
				</select>
				<input name="cache_ttl" type="number" min="0" value={ fmt.Sprintf("%d", zone.CacheTTL) }/>
				<button type="submit">Save Zone Config</button>
			</div>
		</form>
	</dialog>
}

templ ZoneRecordsModal(zone ZoneData) {
	<dialog id={ fmt.Sprintf("zone-records-%s", zoneDOMID(zone.Name)) } class="modal">
		<div class="modal-head">
			<h3>Records - { zone.Name }</h3>
			<button type="button" data-close-modal={ fmt.Sprintf("zone-records-%s", zoneDOMID(zone.Name)) }>Close</button>
		</div>
		<table>
			<thead>
				<tr>
					<th>Name</th>
					<th>Type</th>
					<th>Value</th>
					<th>TTL</th>
					<th>Priority</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				if len(zone.Records) == 0 {
					<tr><td colspan="6" class="subtle">No records yet.</td></tr>
				}
				for _, record := range zone.Records {
					<tr>
						<td>{ record.Name }</td>
						<td>{ record.Type }</td>
						<td>{ record.Value }</td>
						<td>{ fmt.Sprintf("%d", record.TTL) }</td>
						<td>{ fmt.Sprintf("%d", record.Priority) }</td>
						<td>
							<form method="post" action={ fmt.Sprintf("/admin/zones/%s/records/%s/delete", zonePathSegment(zone.Name), recordPathSegment(record.ID)) }>
								<button class="btn-delete" type="submit">Delete</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<h3 style="margin-top:16px;">Add Record</h3>
		<form method="post" action={ fmt.Sprintf("/admin/zones/%s/records", zonePathSegment(zone.Name)) }>
			<div class="grid">
				<input name="name" placeholder="@ / api / mail" required/>
				<select name="type" required>
					<option value="A">A</option>
					<option value="AAAA">AAAA</option>
					<option value="CNAME">CNAME</option>
					<option value="MX">MX</option>
					<option value="TXT">TXT</option>
					<option value="NS">NS</option>
				</select>
				<input name="value" placeholder="value (IP/host/text)" required/>
				<input name="ttl" type="number" min="1" value="300" required/>
				<input name="priority" type="number" min="0" value="0"/>
				<button type="submit">Add</button>
			</div>
		</form>
	</dialog>
}
