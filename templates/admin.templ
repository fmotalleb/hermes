package templates

type AdminPageData struct {
	Error                 string
	Zones                 []ZoneData
	Entrypoints           []InboundEntrypoint
	ForwardZones          []ForwardZoneOption
	FallbackForwardZoneID string
}

type ZoneData struct {
	Name          string
	ForwardMode   string
	ForwardZoneID string
	ForwardLabel  string
	CacheTTL      int
	Records       []DNSRecord
}

type DNSRecord struct {
	ID       string
	Name     string
	Type     string
	Value    string
	TTL      int
	Priority int
}

type InboundEntrypoint struct {
	ID            string
	Type          string
	ListenAddress string
	Port          int
	PublicKey     string
	PrivateKey    string
}

type ForwardZoneOption struct {
	ID       string
	Name     string
	Addresses []string
}

templ AdminPage(data AdminPageData) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>DNS Admin</title>
			<link rel="stylesheet" href="/static/admin.css"/>
			<script>
				(() => {
				  const saved = localStorage.getItem("theme");
				  const defaultTheme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				  document.documentElement.setAttribute("data-theme", defaultTheme);
				  window.toggleTheme = () => {
				    const current = document.documentElement.getAttribute("data-theme") || "light";
				    const next = current === "light" ? "dark" : "light";
				    document.documentElement.setAttribute("data-theme", next);
				    localStorage.setItem("theme", next);
				    const label = document.getElementById("theme-label");
				    if (label) label.textContent = next === "light" ? "Dark Mode" : "Light Mode";
				  };
				  window.addEventListener("DOMContentLoaded", () => {
				    const current = document.documentElement.getAttribute("data-theme") || "light";
				    const label = document.getElementById("theme-label");
				    if (label) label.textContent = current === "light" ? "Dark Mode" : "Light Mode";
				    document.querySelectorAll("[data-open-modal]").forEach((btn) => {
				      btn.addEventListener("click", () => {
				        const id = btn.getAttribute("data-open-modal");
				        const el = document.getElementById(id);
				        if (el && typeof el.showModal === "function") el.showModal();
				      });
				    });
				    document.querySelectorAll("[data-close-modal]").forEach((btn) => {
				      btn.addEventListener("click", () => {
				        const id = btn.getAttribute("data-close-modal");
				        const el = document.getElementById(id);
				        if (el && typeof el.close === "function") el.close();
				      });
				    });
				    document.querySelectorAll("form").forEach((form) => {
				      form.querySelectorAll("[data-entrypoint-type]").forEach((sel) => {
				        const sync = () => {
				          const showTLS = sel.value === "TLS" || sel.value === "HTTPS";
				          form.querySelectorAll("[data-tls-field]").forEach((el) => {
				            el.style.display = showTLS ? "" : "none";
				            if (!showTLS) el.value = "";
				          });
				        };
				        sel.addEventListener("change", sync);
				        sync();
				      });
				    });
				    const addBtn = document.getElementById("add-forward-address");
				    const addressContainer = document.getElementById("forward-zone-addresses");
				    if (addBtn && addressContainer) {
				      addBtn.addEventListener("click", () => {
				        const input = document.createElement("input");
				        input.name = "address_item";
				        input.placeholder = "Resolver Address";
				        addressContainer.appendChild(input);
				      });
				    }
				    const createForwardForm = document.querySelector("dialog#forward-zone-create-modal form");
				    if (createForwardForm) {
				      createForwardForm.addEventListener("submit", () => {
				        const values = Array.from(createForwardForm.querySelectorAll("input[name='address_item']")).map((x) => x.value.trim()).filter(Boolean);
				        const hidden = createForwardForm.querySelector("#addresses_csv");
				        if (hidden) hidden.value = values.join(",");
				      });
				    }
				    document.querySelectorAll("[data-add-forward-address]").forEach((btn) => {
				      btn.addEventListener("click", () => {
				        const id = btn.getAttribute("data-add-forward-address");
				        const holder = document.getElementById("forward-zone-addresses-edit-" + id);
				        if (!holder) return;
				        const input = document.createElement("input");
				        input.name = "address_item_edit_" + id;
				        input.placeholder = "Resolver Address";
				        holder.appendChild(input);
				      });
				    });
				    document.querySelectorAll("dialog[id^='forward-zone-edit-'] form").forEach((form) => {
				      form.addEventListener("submit", () => {
				        const id = form.action.split("/").pop();
				        const values = Array.from(form.querySelectorAll("input[name='address_item_edit_" + id + "']")).map((x) => x.value.trim()).filter(Boolean);
				        const hidden = form.querySelector("#addresses_csv_edit_" + id);
				        if (hidden) hidden.value = values.join(",");
				      });
				    });
				  });
				})();
			</script>
		</head>
		<body>
			@Header()
			<section class="duo-grid">
				@InboundPanel(data.Entrypoints)
				@ForwardZonesPanel(data.ForwardZones, data.FallbackForwardZoneID)
			</section>
			@ZoneCreate(data.ForwardZones, data.FallbackForwardZoneID)
			if data.Error != "" {
				@ErrorBox(data.Error)
			}
			if len(data.Zones) == 0 {
				<section class="panel empty">No zones yet.</section>
			}
			for _, zone := range data.Zones {
				@ZoneRow(zone)
				@ZoneRecordsModal(zone)
				@ZoneConfigModal(zone, data.ForwardZones, data.FallbackForwardZoneID)
			}
		</body>
	</html>
}

templ ErrorBox(message string) {
	<div class="error">{ message }</div>
}
