package templates

import "fmt"

templ InboundPanel(entrypoints []InboundEntrypoint) {
	<section class="panel side-panel">
		<div class="zone-head">
			<h2>Inbound Entrypoints</h2>
			<button type="button" data-open-modal="entrypoint-create-modal">Add Entrypoint</button>
		</div>
		<div class="endpoint-wrap">
			for _, ep := range entrypoints {
				<div class="endpoint-card">
					<div class="endpoint-title">{ "DNS over " + ep.Type }</div>
					<div class="subtle">{ ep.ListenAddress + ":" + fmt.Sprintf("%d", ep.Port) }</div>
					if ep.Type == "TLS" || ep.Type == "HTTPS" {
						<div class="subtle">TLS keys configured</div>
					}
					<div class="zone-actions">
						<button type="button" data-open-modal={ "entrypoint-edit-" + ep.ID }>Edit</button>
						<form method="post" action={ "/admin/inbound/" + recordPathSegment(ep.ID) + "/delete" }>
							<button class="btn-delete" type="submit">Delete</button>
						</form>
					</div>
				</div>
				@EntrypointModal("entrypoint-edit-"+ep.ID, "Edit Entrypoint", "/admin/inbound/"+recordPathSegment(ep.ID), ep)
			}
		</div>
	</section>
	@EntrypointModal("entrypoint-create-modal", "Add Entrypoint", "/admin/inbound", InboundEntrypoint{Type: "UDP"})
}

templ EntrypointModal(id, title, action string, ep InboundEntrypoint) {
	<dialog id={ id } class="modal">
		<div class="modal-head">
			<h3>{ title }</h3>
			<button type="button" data-close-modal={ id }>Close</button>
		</div>
		<form method="post" action={ action } class="grid">
			<select name="type" data-entrypoint-type required>
				<option value="UDP" selected?={ ep.Type == "UDP" }>UDP</option>
				<option value="TCP" selected?={ ep.Type == "TCP" }>TCP</option>
				<option value="TLS" selected?={ ep.Type == "TLS" }>TLS</option>
				<option value="HTTPS" selected?={ ep.Type == "HTTPS" }>HTTPS</option>
			</select>
			<input name="listen_address" placeholder="Listen Address" value={ ep.ListenAddress } required/>
			<input name="port" type="number" min="1" max="65535" value={ fmt.Sprintf("%d", ep.Port) } required/>
			<input name="public_key" data-tls-field placeholder="Public Key Path" value={ ep.PublicKey }/>
			<input name="private_key" data-tls-field placeholder="Private Key Path" value={ ep.PrivateKey }/>
			<button type="submit">Save</button>
		</form>
	</dialog>
}
