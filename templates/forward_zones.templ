package templates

import "strings"

templ ForwardZonesPanel(options []ForwardZoneOption, fallbackForwardZoneID string) {
	<section class="panel side-panel">
		<h2>Forward Zones</h2>
		<div class="zone-actions">
			<button type="button" data-open-modal="forward-zone-create-modal">Add Forward Zone</button>
		</div>
		<form method="post" action="/admin/forward-zones/fallback" class="grid" style="margin-top:10px;">
			<select name="fallback_forward_zone_id">
				<option value="" selected?={ fallbackForwardZoneID == "" }>None (no recursive fallback)</option>
				for _, opt := range options {
					<option value={ opt.ID } selected?={ fallbackForwardZoneID == opt.ID }>{ opt.Name + " (" + strings.Join(opt.Addresses, ", ") + ")" }</option>
				}
			</select>
			<button type="submit">Save Fallback</button>
		</form>
		<div class="endpoint-wrap">
			for _, opt := range options {
				<div class="endpoint-card square-card">
					<div class="endpoint-title">{ opt.Name }</div>
					<div class="subtle">{ strings.Join(opt.Addresses, ", ") }</div>
					<div class="zone-actions">
						<button type="button" data-open-modal={ "forward-zone-edit-" + opt.ID }>Edit</button>
						<form method="post" action={ "/admin/forward-zones/" + recordPathSegment(opt.ID) + "/delete" }>
							<button class="btn-delete" type="submit">Delete</button>
						</form>
					</div>
				</div>
				<dialog id={ "forward-zone-edit-" + opt.ID } class="modal">
					<div class="modal-head">
						<h3>Edit Forward Zone</h3>
						<button type="button" data-close-modal={ "forward-zone-edit-" + opt.ID }>Close</button>
					</div>
					<form method="post" action={ "/admin/forward-zones/" + recordPathSegment(opt.ID) }>
						<input name="name" value={ opt.Name } required/>
						<input type="hidden" id={ "addresses_csv_edit_" + opt.ID } name="addresses_csv"/>
						<div id={ "forward-zone-addresses-edit-" + opt.ID } class="grid" style="margin-top:10px;">
							for _, addr := range opt.Addresses {
								<input name={ "address_item_edit_" + opt.ID } value={ addr }/>
							}
						</div>
						<div class="zone-actions" style="margin-top:10px;">
							<button type="button" data-add-forward-address={ opt.ID }>Add Address</button>
							<button type="submit">Save</button>
						</div>
					</form>
				</dialog>
			}
		</div>
	</section>

	<dialog id="forward-zone-create-modal" class="modal">
		<div class="modal-head">
			<h3>Add Forward Zone</h3>
			<button type="button" data-close-modal="forward-zone-create-modal">Close</button>
		</div>
		<form method="post" action="/admin/forward-zones">
			<input name="name" placeholder="Provider Name (e.g. Cloudflare)" required/>
			<input type="hidden" id="addresses_csv" name="addresses_csv"/>
			<div id="forward-zone-addresses" class="grid" style="margin-top:10px;">
				<input name="address_item" placeholder="Resolver Address (e.g. 1.1.1.1 or dns.google)" required/>
			</div>
			<div class="zone-actions" style="margin-top:10px;">
				<button type="button" id="add-forward-address">Add Address</button>
				<button type="submit">Create</button>
			</div>
		</form>
	</dialog>
}
