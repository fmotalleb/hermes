APP_NAME=helios
HTTP_PORT=8000

DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=helios
DB_PASSWORD=helios
DB_NAME=helios
DB_SSL_MODE=disable
DB_MAX_IDLE_CONNECTION=5
DB_MAX_OPEN_CONNECTION=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

PUBSUB_BACKEND=REDIS
REDIS_PUBSUB_MODE=streams
REDIS_PUBSUB_DB=1
REDIS_STREAMS_CONSUMER_GROUP=helios-admin
REDIS_STREAMS_CONSUMER_NAME=helios-admin-1
