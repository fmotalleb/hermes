APP_NAME=hermes

ADMIN_NO_AUTH=0

HTTP_PORT=8000

DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=hermes
DB_PASSWORD=hermes
DB_NAME=hermes
DB_SSL_MODE=disable
DB_MAX_IDLE_CONNECTION=5
DB_MAX_OPEN_CONNECTION=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

PUBSUB_BACKEND=REDIS
REDIS_PUBSUB_MODE=pubsub
REDIS_PUBSUB_DB=1
REDIS_STREAMS_CONSUMER_GROUP=hermes-admin
REDIS_STREAMS_CONSUMER_NAME=hermes-admin-1

TRACER_URL=grpc://localhost:4317
TRACER_RATIO=1

# OTEL metric push (same URL/header parsing as TRACER_URL and LOG_URL)
# METRIC_PUSH_URL=grpc://localhost:4317
# METRIC_PUSH_HEADERS={"api-key":"abc"}
# METRIC_PUSH_INTERVAL=60s