    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start API Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "env": {
                "APP_ENV":"local"
            },
            "args": [
                "api"
            ]
        },
        {
            "name": "Start DNS Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/cmd",
            "env": {
                "APP_ENV":"local"
            },
            "args": [
                "dns"
            ]
        }
    ]
}
