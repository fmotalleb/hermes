{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "env": {
                "INSTANCE_NAME":"api",
                "APP_ENV":"local"
            },
            "args": [
                "api",
                "--log-level=debug",
                "--migrate"
            ]
        },
        {
            "name": "DNS Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}",
            "env": {
                "INSTANCE_NAME":"dns.primary",
                "APP_ENV":"local"
            },
            "args": [
                "dns"
            ]
        },
        {
            "name": "DNS Server Secondary",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}",
            "env": {
                "INSTANCE_NAME":"dns.secondary",
                "APP_ENV":"local",
                "DNS_LISTEN_ADDR":":8053"
            },
            "args": [
                "dns"
            ]
        },
        {
            "name": "DNS Server DOH",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}",
            "env": {
                "INSTANCE_NAME":"dns.doh",
                "APP_ENV":"local",
                "DNS_LISTEN_ADDR":":8443",
                "DNS_PROTOCOL": "doh",
                "DNS_TLS_PRIVATE_KEY":"${workspaceFolder}/certs/127.0.0.1.key",
                "DNS_TLS_CERTIFICATE":"${workspaceFolder}/certs/127.0.0.1.crt",
            },
            "args": [
                "dns"
            ]
        }
    ]
}
